{
  "expo": {
    "name": "ShoeTrack",
    "slug": "shoetrack-mobile",
    "version": "1.0.0",
    "description": "Application mobile de gestion de stock et ventes pour une petite boutique de chaussures.",
    "scheme": "shoetrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jengosolutions.shoetrack",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.jengosolutions.shoetrack",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#1D2433",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite"
    ]
  }
}
